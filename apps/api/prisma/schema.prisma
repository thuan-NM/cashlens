generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TransactionDirection {
  INCOME
  EXPENSE
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
}

enum TransactionSourceType {
  EMAIL
  MANUAL
  CSV
  SMS
  API
}

enum TransactionStatus {
  PENDING
  POSTED
  IGNORED
  DELETED
  NEEDS_REVIEW
}

enum ClassificationSource {
  RULE
  ML
  LLM
  MANUAL
  SYSTEM
  UNKNOWN
}

enum TransactionCategoryType {
  INCOME
  EXPENSE
  TRANSFER
  NEUTRAL
}

enum TransactionCategoryStatus {
  ACTIVE
  ARCHIVED
}

enum RawEmailStatus {
  PENDING
  PARSED
  FAILED
  IGNORED
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
  PENDING_DELETE
}

enum AuditActorType {
  USER
  SYSTEM
  ADMIN
  WORKER
}

enum AccountType {
  BANK_ACCOUNT
  CHECKING
  SAVINGS
  CREDIT_CARD
  CASH
  E_WALLET
  INVESTMENT
  OTHER
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
  CLOSED
}

enum BudgetPeriod {
  WEEKLY
  MONTHLY
  YEARLY
  CUSTOM
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String?
  fullName     String?
  role         UserRole   @default(USER)
  timezone     String     @default("Asia/Ho_Chi_Minh")
  locale       String     @default("vi-VN")
  baseCurrency String     @default("VND")
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?
  metadata     Json?

  settings      UserSettings?
  transactions  Transaction[]
  rawEmails     RawEmail[]
  categories    TransactionCategory[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  accounts      FinancialAccount[]
  budgets       Budget[]
  merchantRules MerchantRule[]
}

model UserSettings {
  id                        String   @id @default(cuid())
  userId                    String   @unique
  storeRawEmailBody         Boolean  @default(false)
  allowAiInsights           Boolean  @default(false)
  autoClassificationEnabled Boolean  @default(true)
  defaultMonthStartDay      Int      @default(1)
  dataRetentionDays         Int?
  notificationEnabled       Boolean  @default(true)
  metadata                  Json?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ipAddress String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([userId, revokedAt])
}

model AuditLog {
  id           String         @id @default(cuid())
  userId       String?
  actorType    AuditActorType @default(USER)
  action       String
  resourceType String
  resourceId   String?
  ipAddress    String?
  userAgent    String?
  metadata     Json?
  createdAt    DateTime       @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([resourceType, resourceId])
  @@index([action, createdAt])
}

model RawEmail {
  id          String         @id @default(cuid())
  userId      String
  provider    String         @default("gmail")
  messageId   String         @unique
  sender      String?
  subject     String?
  snippet     String?
  receivedAt  DateTime?
  processedAt DateTime?
  status      RawEmailStatus @default(PENDING)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
}

model Transaction {
  id                       String                @id @default(cuid())
  userId                   String
  rawEmailId               String?
  categoryId               String?
  financialAccountId       String?
  bankProviderId           String?
  bankName                 String?
  merchantName             String?
  counterpartyName         String?
  sourceType               TransactionSourceType @default(MANUAL)
  sourceId                 String?
  externalTransactionId    String?
  transactionCode          String?
  amount                   Decimal               @db.Decimal(18, 2)
  currency                 String                @default("VND")
  direction                TransactionDirection
  transactionTime          DateTime
  postedDate               DateTime?
  description              String?
  normalizedDescription    String?
  balanceAfter             Decimal?              @db.Decimal(18, 2)
  feeAmount                Decimal?              @db.Decimal(18, 2)
  status                   TransactionStatus     @default(POSTED)
  isDuplicate              Boolean               @default(false)
  duplicateOfTransactionId String?
  classificationSource     ClassificationSource  @default(UNKNOWN)
  classificationConfidence Decimal?              @db.Decimal(5, 4)
  userNote                 String?
  confidence               Float?
  metadata                 Json?
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt

  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  rawEmail    RawEmail?            @relation(fields: [rawEmailId], references: [id], onDelete: SetNull)
  category    TransactionCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  account     FinancialAccount?    @relation(fields: [financialAccountId], references: [id], onDelete: SetNull)
  duplicateOf Transaction?         @relation("TransactionDuplicate", fields: [duplicateOfTransactionId], references: [id], onDelete: SetNull)
  duplicates  Transaction[]        @relation("TransactionDuplicate")

  @@unique([userId, externalTransactionId])
  @@index([userId, transactionTime])
  @@index([userId, direction])
  @@index([userId, status])
  @@index([userId, sourceType])
  @@index([userId, categoryId])
  @@index([userId, financialAccountId])
  @@index([userId, merchantName])
}

model TransactionCategory {
  id                   String                    @id @default(cuid())
  userId               String?
  parentId             String?
  name                 String
  slug                 String
  type                 TransactionCategoryType   @default(EXPENSE)
  icon                 String?
  color                String?
  isSystem             Boolean                   @default(false)
  excludeFromBudget    Boolean                   @default(false)
  excludeFromAnalytics Boolean                   @default(false)
  sortOrder            Int                       @default(100)
  status               TransactionCategoryStatus @default(ACTIVE)
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  user          User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent        TransactionCategory?  @relation("TransactionCategoryParent", fields: [parentId], references: [id], onDelete: SetNull)
  children      TransactionCategory[] @relation("TransactionCategoryParent")
  transactions  Transaction[]
  budgets       Budget[]
  merchantRules MerchantRule[]

  @@unique([userId, slug])
  @@index([userId, status])
  @@index([parentId])
}

model FinancialAccount {
  id               String        @id @default(cuid())
  userId           String
  bankProviderId   String?
  name             String
  institutionName  String?
  accountMask      String?
  type             AccountType   @default(CHECKING)
  currency         String        @default("VND")
  openingBalance   Decimal       @default(0) @db.Decimal(18, 2)
  currentBalance   Decimal?      @db.Decimal(18, 2)
  creditLimit      Decimal?      @db.Decimal(18, 2)
  isDefault        Boolean       @default(false)
  status           AccountStatus @default(ACTIVE)
  balanceUpdatedAt DateTime?
  lastSyncedAt     DateTime?
  metadata         Json?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([userId, name])
  @@index([userId, status])
  @@index([userId, isDefault])
}

model Budget {
  id         String       @id @default(cuid())
  userId     String
  categoryId String?
  name       String
  amount     Decimal      @db.Decimal(18, 2)
  currency   String       @default("VND")
  period     BudgetPeriod @default(MONTHLY)
  startsAt   DateTime
  endsAt     DateTime?
  rollover   Boolean      @default(false)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  deletedAt  DateTime?

  user     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  category TransactionCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId, period])
  @@index([userId, startsAt])
}

model MerchantRule {
  id                 String                @id @default(cuid())
  userId             String
  categoryId         String?
  merchantPattern    String?
  descriptionPattern String?
  bankName           String?
  direction          TransactionDirection?
  priority           Int                   @default(100)
  isActive           Boolean               @default(true)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  user     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  category TransactionCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId, isActive])
  @@index([userId, priority])
}
