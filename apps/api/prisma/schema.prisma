generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TransactionDirection {
  INCOME
  EXPENSE
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
}

enum TransactionSourceType {
  EMAIL
  MANUAL
  CSV
  SMS
  API
}

enum TransactionStatus {
  PENDING
  POSTED
  IGNORED
  DELETED
  NEEDS_REVIEW
}

enum ClassificationSource {
  RULE
  ML
  LLM
  MANUAL
  SYSTEM
  UNKNOWN
}

enum TransactionCategoryType {
  INCOME
  EXPENSE
  TRANSFER
  NEUTRAL
}

enum TransactionCategoryStatus {
  ACTIVE
  ARCHIVED
}

enum RawEmailStatus {
  PENDING
  PARSED
  FAILED
  IGNORED
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
  PENDING_DELETE
}

enum AuditActorType {
  USER
  SYSTEM
  ADMIN
  WORKER
}

enum AccountType {
  BANK_ACCOUNT
  CHECKING
  SAVINGS
  CREDIT_CARD
  CASH
  E_WALLET
  INVESTMENT
  OTHER
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
  CLOSED
}

enum BudgetPeriod {
  WEEKLY
  MONTHLY
  YEARLY
  CUSTOM
}

enum GoalStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum GoalPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum GoalScenarioType {
  FULL
  INSTALLMENT
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AlertType {
  BUDGET_THRESHOLD
  LARGE_TRANSACTION
  CATEGORY_SHIFT
  GOAL_RISK
  CASHFLOW_RISK
  PARSER_ISSUE
  SYSTEM
}

enum EmailProvider {
  GMAIL
  OUTLOOK
  IMAP
}

enum EmailConnectionStatus {
  ACTIVE
  EXPIRED
  REVOKED
  ERROR
}

enum EmailProcessingStatus {
  PENDING
  IGNORED
  PARSED
  FAILED
}

enum EmailSyncTriggerType {
  MANUAL
  SCHEDULED
  WEBHOOK
  BACKFILL
}

enum EmailSyncStatus {
  RUNNING
  SUCCESS
  PARTIAL_FAILED
  FAILED
}

enum BankProviderStatus {
  ACTIVE
  INACTIVE
  EXPERIMENTAL
}

enum BankEmailSenderStatus {
  ACTIVE
  DEPRECATED
  SUSPICIOUS
}

enum ParserChannel {
  EMAIL
  CSV
  SMS
  API
}

enum ParserFieldType {
  MONEY
  DATETIME
  TEXT
  NUMBER
  DIRECTION
}

enum ParserRunStatus {
  SUCCESS
  FAILED
  PARTIAL
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String?
  fullName     String?
  role         UserRole   @default(USER)
  timezone     String     @default("Asia/Ho_Chi_Minh")
  locale       String     @default("vi-VN")
  baseCurrency String     @default("VND")
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?
  metadata     Json?

  settings         UserSettings?
  transactions     Transaction[]
  rawEmails        RawEmail[]
  categories       TransactionCategory[]
  refreshTokens    RefreshToken[]
  auditLogs        AuditLog[]
  accounts         FinancialAccount[]
  budgets          Budget[]
  goals            Goal[]
  alerts           Alert[]
  alertSettings    AlertSetting[]
  merchantRules    MerchantRule[]
  emailConnections EmailConnection[]
  emailListenRules EmailListenRule[]
  emailMessages    EmailMessage[]
}

model UserSettings {
  id                        String   @id @default(cuid())
  userId                    String   @unique
  storeRawEmailBody         Boolean  @default(false)
  allowAiInsights           Boolean  @default(false)
  autoClassificationEnabled Boolean  @default(true)
  defaultMonthStartDay      Int      @default(1)
  dataRetentionDays         Int?
  notificationEnabled       Boolean  @default(true)
  metadata                  Json?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ipAddress String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([userId, revokedAt])
}

model AuditLog {
  id           String         @id @default(cuid())
  userId       String?
  actorType    AuditActorType @default(USER)
  action       String
  resourceType String
  resourceId   String?
  ipAddress    String?
  userAgent    String?
  metadata     Json?
  createdAt    DateTime       @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([resourceType, resourceId])
  @@index([action, createdAt])
}

model RawEmail {
  id          String         @id @default(cuid())
  userId      String
  provider    String         @default("gmail")
  messageId   String         @unique
  sender      String?
  subject     String?
  snippet     String?
  receivedAt  DateTime?
  processedAt DateTime?
  status      RawEmailStatus @default(PENDING)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
}

model Transaction {
  id                       String                @id @default(cuid())
  userId                   String
  rawEmailId               String?
  emailMessageId           String?               @unique
  categoryId               String?
  financialAccountId       String?
  bankProviderId           String?
  bankName                 String?
  merchantName             String?
  counterpartyName         String?
  sourceType               TransactionSourceType @default(MANUAL)
  sourceId                 String?
  externalTransactionId    String?
  transactionCode          String?
  amount                   Decimal               @db.Decimal(18, 2)
  currency                 String                @default("VND")
  direction                TransactionDirection
  transactionTime          DateTime
  postedDate               DateTime?
  description              String?
  normalizedDescription    String?
  balanceAfter             Decimal?              @db.Decimal(18, 2)
  feeAmount                Decimal?              @db.Decimal(18, 2)
  status                   TransactionStatus     @default(POSTED)
  isDuplicate              Boolean               @default(false)
  duplicateOfTransactionId String?
  classificationSource     ClassificationSource  @default(UNKNOWN)
  classificationConfidence Decimal?              @db.Decimal(5, 4)
  userNote                 String?
  confidence               Float?
  metadata                 Json?
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  rawEmail     RawEmail?            @relation(fields: [rawEmailId], references: [id], onDelete: SetNull)
  emailMessage EmailMessage?        @relation(fields: [emailMessageId], references: [id], onDelete: SetNull)
  category     TransactionCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  account      FinancialAccount?    @relation(fields: [financialAccountId], references: [id], onDelete: SetNull)
  duplicateOf  Transaction?         @relation("TransactionDuplicate", fields: [duplicateOfTransactionId], references: [id], onDelete: SetNull)
  duplicates   Transaction[]        @relation("TransactionDuplicate")
  parserRuns   ParserRun[]

  @@unique([userId, externalTransactionId])
  @@index([userId, transactionTime])
  @@index([userId, direction])
  @@index([userId, status])
  @@index([userId, sourceType])
  @@index([userId, categoryId])
  @@index([userId, financialAccountId])
  @@index([userId, merchantName])
}

model TransactionCategory {
  id                   String                    @id @default(cuid())
  userId               String?
  parentId             String?
  name                 String
  slug                 String
  type                 TransactionCategoryType   @default(EXPENSE)
  icon                 String?
  color                String?
  isSystem             Boolean                   @default(false)
  excludeFromBudget    Boolean                   @default(false)
  excludeFromAnalytics Boolean                   @default(false)
  sortOrder            Int                       @default(100)
  status               TransactionCategoryStatus @default(ACTIVE)
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  user          User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent        TransactionCategory?  @relation("TransactionCategoryParent", fields: [parentId], references: [id], onDelete: SetNull)
  children      TransactionCategory[] @relation("TransactionCategoryParent")
  transactions  Transaction[]
  budgets       Budget[]
  merchantRules MerchantRule[]

  @@unique([userId, slug])
  @@index([userId, status])
  @@index([parentId])
}

model FinancialAccount {
  id               String        @id @default(cuid())
  userId           String
  bankProviderId   String?
  name             String
  institutionName  String?
  accountMask      String?
  type             AccountType   @default(CHECKING)
  currency         String        @default("VND")
  openingBalance   Decimal       @default(0) @db.Decimal(18, 2)
  currentBalance   Decimal?      @db.Decimal(18, 2)
  creditLimit      Decimal?      @db.Decimal(18, 2)
  isDefault        Boolean       @default(false)
  status           AccountStatus @default(ACTIVE)
  balanceUpdatedAt DateTime?
  lastSyncedAt     DateTime?
  metadata         Json?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([userId, name])
  @@index([userId, status])
  @@index([userId, isDefault])
}

model Budget {
  id               String       @id @default(cuid())
  userId           String
  categoryId       String?
  name             String
  amount           Decimal      @db.Decimal(18, 2)
  currency         String       @default("VND")
  period           BudgetPeriod @default(MONTHLY)
  startsAt         DateTime
  endsAt           DateTime?
  thresholdPercent Int          @default(80)
  rollover         Boolean      @default(false)
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  deletedAt        DateTime?

  user     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  category TransactionCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId, period])
  @@index([userId, startsAt])
  @@index([userId, isActive])
}

model Goal {
  id           String       @id @default(cuid())
  userId       String
  name         String
  type         String?
  targetAmount Decimal      @db.Decimal(18, 2)
  savedAmount  Decimal      @default(0) @db.Decimal(18, 2)
  currency     String       @default("VND")
  targetDate   DateTime?
  months       Int?
  priority     GoalPriority @default(MEDIUM)
  status       GoalStatus   @default(ACTIVE)
  metadata     Json?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, targetDate])
}

model Alert {
  id           String        @id @default(cuid())
  userId       String
  type         AlertType
  severity     AlertSeverity @default(INFO)
  title        String
  message      String
  resourceType String?
  resourceId   String?
  isRead       Boolean       @default(false)
  readAt       DateTime?
  metadata     Json?
  createdAt    DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@index([userId, severity, createdAt])
  @@index([resourceType, resourceId])
}

model AlertSetting {
  id           String    @id @default(cuid())
  userId       String
  type         AlertType
  inAppEnabled Boolean   @default(true)
  emailEnabled Boolean   @default(false)
  threshold    Decimal?  @db.Decimal(18, 2)
  metadata     Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([userId, inAppEnabled])
}

model MerchantRule {
  id                 String                @id @default(cuid())
  userId             String
  categoryId         String?
  merchantPattern    String?
  descriptionPattern String?
  bankName           String?
  direction          TransactionDirection?
  priority           Int                   @default(100)
  isActive           Boolean               @default(true)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  user     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  category TransactionCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId, isActive])
  @@index([userId, priority])
}

model BankProvider {
  id                String             @id @default(cuid())
  code              String             @unique
  name              String
  countryCode       String             @default("VN")
  website           String?
  logoUrl           String?
  status            BankProviderStatus @default(ACTIVE)
  supportedChannels String[]           @default(["email"])
  metadata          Json?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  emailSenders    BankEmailSender[]
  listenRules     EmailListenRule[]
  emailMessages   EmailMessage[]
  parserTemplates ParserTemplate[]

  @@index([status, countryCode])
}

model BankEmailSender {
  id              String                @id @default(cuid())
  bankProviderId  String
  senderEmail     String
  senderDomain    String?
  senderName      String?
  isVerified      Boolean               @default(false)
  confidenceScore Decimal?              @db.Decimal(5, 4)
  status          BankEmailSenderStatus @default(ACTIVE)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  bankProvider BankProvider @relation(fields: [bankProviderId], references: [id], onDelete: Cascade)

  @@unique([bankProviderId, senderEmail])
  @@index([senderEmail, status])
}

model EmailConnection {
  id                    String                @id @default(cuid())
  userId                String
  provider              EmailProvider
  emailAddress          String
  providerUserId        String?
  accessTokenEncrypted  String
  refreshTokenEncrypted String
  tokenExpiresAt        DateTime
  scopes                String[]              @default([])
  status                EmailConnectionStatus @default(ACTIVE)
  lastSyncedAt          DateTime?
  connectedAt           DateTime              @default(now())
  disconnectedAt        DateTime?
  errorMessage          String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  listenRules EmailListenRule[]
  syncRuns    EmailSyncRun[]
  messages    EmailMessage[]

  @@unique([userId, provider, emailAddress])
  @@index([userId, status])
}

model EmailListenRule {
  id                String    @id @default(cuid())
  userId            String
  emailConnectionId String?
  bankProviderId    String?
  name              String
  senderEmail       String?
  senderDomain      String?
  subjectContains   String?
  bodyContains      String?
  syncFromDate      DateTime?
  isEnabled         Boolean   @default(true)
  priority          Int       @default(100)
  lastMatchedAt     DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailConnection EmailConnection? @relation(fields: [emailConnectionId], references: [id], onDelete: Cascade)
  bankProvider    BankProvider?    @relation(fields: [bankProviderId], references: [id], onDelete: SetNull)
  messages        EmailMessage[]

  @@index([userId, isEnabled, priority])
  @@index([emailConnectionId, isEnabled])
}

model EmailSyncRun {
  id                  String               @id @default(cuid())
  emailConnectionId   String
  triggerType         EmailSyncTriggerType @default(MANUAL)
  status              EmailSyncStatus      @default(RUNNING)
  startedAt           DateTime             @default(now())
  finishedAt          DateTime?
  emailsFound         Int                  @default(0)
  emailsMatched       Int                  @default(0)
  emailsParsed        Int                  @default(0)
  transactionsCreated Int                  @default(0)
  errorMessage        String?
  createdAt           DateTime             @default(now())

  emailConnection EmailConnection @relation(fields: [emailConnectionId], references: [id], onDelete: Cascade)

  @@index([emailConnectionId, startedAt])
  @@index([status, startedAt])
}

model EmailMessage {
  id                String                @id @default(cuid())
  userId            String
  emailConnectionId String
  providerMessageId String
  providerThreadId  String?
  providerHistoryId String?
  messageIdHeader   String?
  senderEmail       String
  senderName        String?
  subject           String?
  snippet           String?
  receivedAt        DateTime
  bodyHash          String?
  processingStatus  EmailProcessingStatus @default(PENDING)
  matchedRuleId     String?
  bankProviderId    String?
  errorMessage      String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailConnection EmailConnection  @relation(fields: [emailConnectionId], references: [id], onDelete: Cascade)
  matchedRule     EmailListenRule? @relation(fields: [matchedRuleId], references: [id], onDelete: SetNull)
  bankProvider    BankProvider?    @relation(fields: [bankProviderId], references: [id], onDelete: SetNull)
  parserRuns      ParserRun[]
  transaction     Transaction?

  @@unique([emailConnectionId, providerMessageId])
  @@index([userId, receivedAt])
  @@index([emailConnectionId, processingStatus])
  @@index([bankProviderId, receivedAt])
}

model ParserTemplate {
  id             String                @id @default(cuid())
  bankProviderId String
  name           String
  version        Int
  channel        ParserChannel         @default(EMAIL)
  language       String?
  directionHint  TransactionDirection?
  subjectPattern String?
  bodyPattern    String?
  isActive       Boolean               @default(true)
  priority       Int                   @default(100)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  bankProvider BankProvider  @relation(fields: [bankProviderId], references: [id], onDelete: Cascade)
  fields       ParserField[]
  runs         ParserRun[]

  @@unique([bankProviderId, name, version])
  @@index([bankProviderId, channel, isActive, priority])
}

model ParserField {
  id               String          @id @default(cuid())
  parserTemplateId String
  fieldName        String
  fieldType        ParserFieldType
  regexPattern     String
  regexGroupIndex  Int             @default(1)
  normalizer       String?
  isRequired       Boolean         @default(false)
  fallbackValue    String?
  priority         Int             @default(100)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  parserTemplate ParserTemplate @relation(fields: [parserTemplateId], references: [id], onDelete: Cascade)

  @@index([parserTemplateId, fieldName, priority])
}

model ParserRun {
  id                   String          @id @default(cuid())
  emailMessageId       String
  parserTemplateId     String?
  status               ParserRunStatus
  confidenceScore      Decimal?        @db.Decimal(5, 4)
  extractedPayload     Json
  normalizedPayload    Json
  errorMessage         String?
  createdTransactionId String?
  createdAt            DateTime        @default(now())

  emailMessage       EmailMessage    @relation(fields: [emailMessageId], references: [id], onDelete: Cascade)
  parserTemplate     ParserTemplate? @relation(fields: [parserTemplateId], references: [id], onDelete: SetNull)
  createdTransaction Transaction?    @relation(fields: [createdTransactionId], references: [id], onDelete: SetNull)

  @@index([emailMessageId, createdAt])
  @@index([parserTemplateId, status])
}
