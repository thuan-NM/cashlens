# CashLens API environment example (CFG-003).
#
# Create your git-ignored apps/api/.env with:
#   ./scripts/init-local-env.ps1
# It copies this file and replaces the random-secret placeholders without
# printing them. Every value here is a placeholder or a development-only
# default. Production startup rejects every known placeholder (CFG-001), so
# none of these values can run a production deployment. Never put a real
# secret in this file.
#
# Legend:
#   [required] always required
#   [prod]     required when NODE_ENV=production (optional in development/test)
#   [smtp]     required when EMAIL_TRANSPORT=smtp
#   [optional] may be omitted; the default is shown

# --- Runtime ----------------------------------------------------------------
# [optional] development | test | production (default: development)
NODE_ENV="development"
# [optional] HTTP port, 1-65535 (default: 3000)
PORT="3000"
# [optional] fatal | error | warn | info | debug | trace | silent
#            (default: info in production, debug otherwise)
LOG_LEVEL="debug"

# --- Database ---------------------------------------------------------------
# [prod] postgresql:// URL. This development value matches docker-compose.yml.
#        Production rejects the placeholder password.
DATABASE_URL="postgresql://cashlens:cashlens_password@localhost:5432/cashlens_db?schema=public"

# --- Authentication and sessions --------------------------------------------
# [required] JWT signing secret. Production: at least 32 random characters.
JWT_SECRET="replace-with-a-random-jwt-secret"
# [optional] access-token lifetime such as 15m, 1h, 7d (default when unset: 7d)
JWT_EXPIRES_IN="15m"
# [optional] refresh-token lifetime in days, 1-365 (default: 30)
JWT_REFRESH_EXPIRES_IN_DAYS="30"
# [optional] true | false (default: true in production, false otherwise).
#            Production rejects false.
COOKIE_SECURE="false"
# [optional] lax | strict (default: lax)
COOKIE_SAME_SITE="lax"

# --- HTTP boundary ------------------------------------------------------------
# [prod] Comma-separated browser origins without paths (default in development:
#        http://localhost:5173). Production: https only. In production the web
#        app and API share one public origin (OPS-009).
CORS_ORIGIN="http://localhost:5173"
# [prod] Trusted proxy hops: loopback, linklocal, uniquelocal, IP addresses, or
#        CIDR ranges, comma-separated (default in development: loopback).
#        Production value must cover the address the API observes for proxied
#        requests; release verification (T100) checks it.
TRUST_PROXY="loopback"

# --- Gmail integration --------------------------------------------------------
# [prod] Key for encrypting stored Gmail tokens: at least 32 characters in
#        every mode. Changing it makes stored Gmail tokens unreadable, so users
#        must reconnect Gmail (CFG-005).
EMAIL_TOKEN_ENCRYPTION_KEY="replace-with-at-least-32-random-characters"
# [prod] OAuth client from the Google Cloud console (leave empty in development
#        until you configure a Gmail test client).
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
# [prod] OAuth callback URL. Production: https://<public-origin>/api/email-connections/gmail/callback
GMAIL_REDIRECT_URI="http://localhost:3000/api/email-connections/gmail/callback"
# [prod] OAuth state signing secret. Production: at least 32 random characters.
GMAIL_OAUTH_STATE_SECRET="replace-with-a-random-oauth-state-secret"

# --- Email alert delivery (CFG-007) -------------------------------------------
# [optional] disabled | smtp | log (default: disabled). The redacted log
#            transport is rejected in production.
EMAIL_TRANSPORT="disabled"
# [smtp] SMTP relay settings. SMTP_SECURE=true means implicit TLS; otherwise
#        STARTTLS is required (default: false).
# SMTP_HOST="smtp.example.test"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="alerts@example.test"
# SMTP_PASSWORD="replace-with-smtp-password"
# [smtp] Sender address, e.g. "CashLens <alerts@example.test>"
# EMAIL_FROM="alerts@example.test"
# [smtp] Public origin used for links in alert emails. Production: https only.
# APP_PUBLIC_URL="http://localhost:5173"
# [optional] Per-attempt timeout and total delivery budget in milliseconds
#            (defaults: 5000 and 12000; the budget must be >= the timeout).
EMAIL_ATTEMPT_TIMEOUT_MS="5000"
EMAIL_TOTAL_BUDGET_MS="12000"

# --- Docker Compose interpolation (read by docker-compose*.yml, not the API) ---
# [optional] Development database credentials (defaults shown) and host ports.
# POSTGRES_USER="cashlens"
# POSTGRES_PASSWORD="cashlens_password"
# POSTGRES_DB="cashlens_db"
# POSTGRES_HOST_PORT="5432"
# [optional] API host port for both compose files (default: 3000). In the
#            development stack, also set VITE_API_BASE_URL to match, for example
#            API_HOST_PORT=13000 with VITE_API_BASE_URL=http://localhost:13000/api.
# API_HOST_PORT="3000"
# VITE_API_BASE_URL="http://localhost:3000/api"
# [optional] Production compose loopback web port (default: 8080).
# WEB_HOST_PORT="8080"

# --- Web app (build time, apps/web) -------------------------------------------
# VITE_API_BASE_URL: development uses http://localhost:3000/api; the release
# image is always built with the relative /api (same-origin routing).

# --- Tests only (not read by the application) ---------------------------------
# Dedicated e2e database; its name must contain "test".
# E2E_DATABASE_URL="postgresql://cashlens:cashlens_password@localhost:5432/cashlens_test?schema=public"
