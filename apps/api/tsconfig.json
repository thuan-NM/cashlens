{
  "extends": "@repo/typescript-config/node-nest.json",
  "compilerOptions": {
    "outDir": "./dist",
    "typeRoots": ["./node_modules/@types", "../../node_modules/@types"],
    "strictNullChecks": true,
    // Deliberate API relaxations, kept here rather than in the shared config.
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false
  }
}
